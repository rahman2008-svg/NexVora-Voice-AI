# NexVora Voice AI backend - copy to .env (or export). No secrets are required.
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=auto          # auto | cuda:0 | mps | xpu | cpu
OMNIVOICE_DTYPE=auto           # auto -> float16 on cuda/xpu, float32 otherwise
ALLOW_CPU=false                # CPU is slow and unverified for this model
LOAD_MODEL_ON_STARTUP=true
MAX_TEXT_CHARS=1000
MAX_QUEUE=4
RATE_LIMIT_PER_MIN=10
OUTPUT_DIR=./tmp_audio
OUTPUT_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false              # true only behind your own reverse proxy
ENABLE_VOICE_CLONING=false     # enable only if you accept responsibility for consent checks
MAX_UPLOAD_MB=10
SERVE_FRONTEND=true            # serve frontend/dist from this server if it exists
